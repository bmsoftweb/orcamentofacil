PORT=3000

# MySQL: HOST, USER e PASSWORD obrigatórios (o código não tem valor padrão); DATABASE padrão orcamentofacil
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Chave que assina os tokens de sessão. Sem ela, uma chave aleatória é gerada a cada
# reinício do servidor e todos precisam entrar de novo.
SESSION_SECRET=

# Pasta dos arquivos enviados (.dae, anexos, logo)
STORAGE_DIR=./storage

# Caminho do Edge/Chrome usado para gerar os PDFs (opcional; sem ele, procura nos locais padrão)
NAVEGADOR_PDF=
